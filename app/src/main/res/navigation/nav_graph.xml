<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loadFragment">

    <fragment
        android:id="@+id/loadFragment"
        android:name="com.example.productapp.load.presentation.LoadFragment"
        tools:layout="@layout/fragment_loading">
        <action
            android:id="@+id/action_load_to_productList"
            app:destination="@id/productListFragment"
            app:popUpTo="@id/loadFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/productListFragment"
        android:name="com.example.productapp.product.presentation.ProductListFragment">

    <action
            android:id="@+id/action_productList_to_detail"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_productList_to_favorite"
            app:destination="@id/favoriteFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.productapp.detail.presentation.DetailFragment"
        tools:layout="@layout/fragment_detail" />

    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.example.productapp.favorite.presentation.FavoriteFragment">
        <action
            android:id="@+id/action_favorite_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

</navigation>